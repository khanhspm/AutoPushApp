# === Lark ===
LARK_APP_ID=cli_xxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxx
LARK_VERIFICATION_TOKEN=xxxxxxxxxxxxxxx
LARK_ENCRYPT_KEY=xxxxxxxxxxxxxxx
LARK_API_BASE_URL=https://open.larksuite.com

# === CMS authentication ===
# Generate a long random value, for example: openssl rand -hex 32
CMS_ADMIN_TOKEN=replace-with-at-least-32-random-characters
CMS_DEV_ORIGIN=http://localhost:5173
CMS_PUBLIC_URL=http://localhost:5173
# Generate separately from CMS_ADMIN_TOKEN, for example: openssl rand -hex 32
CMS_AUTH_PEPPER=replace-with-another-32-character-random-secret
CMS_SESSION_COOKIE_NAME=autopush_session
SERVE_CMS=false
CMS_DIST_PATH=./web/dist

# === Gmail SMTP for CMS invitations and OTP ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=cms@matechmobile.com
SMTP_APP_PASSWORD=google-workspace-app-password
SMTP_FROM=AutoPush CMS <cms@matechmobile.com>

# === Redis / server ===
REDIS_URL=redis://localhost:6379
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# === Persistence / runner ===
DB_PATH=./data/autopushapp.sqlite
LOG_DIR=./logs/builds
# Native Choose folder opens on the API-host Mac; selected/saved repos must stay under these roots.
# Missing Gemfile/Fastfile support files are created without overwriting existing files; run bundle install separately.
# The API needs an interactive GUI session, and the worker must see the same canonical absolute paths.
IOS_REPO_ROOTS=/Users/your-user/Projects/iOS,/Volumes/BuildRepos
FASTLANE_RUNNER_PATH=./scripts/run_fastlane.sh
# Optional absolute Bundler executable when the system `bundle` uses a different Ruby.
BUNDLE_BIN=/opt/homebrew/lib/ruby/gems/4.0.0/bin/bundle
BUILD_TIMEOUT_MS=3600000
RUNNER_ID=mac-mini-01

# === Per-project secret values ===
# The CMS stores only these variable NAMES, never their values.
# Every project needs a Firebase token. Match-mode projects also need Match/ASC values.
MYAPP_FIREBASE_CLI_TOKEN=1//0xxxxxxxxxxxxxxxxx
MYAPP_MATCH_PASSWORD=xxxxxxxxxxx
MYAPP_ASC_KEY_ID=XXXXXXXXXX
MYAPP_ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MYAPP_ASC_KEY_PATH=/secure/AuthKey_XXXXXXXXXX.p8

# Optional Fastlane Match transport/custom-keychain settings inherited by Match builds:
# MATCH_GIT_BASIC_AUTHORIZATION=...
# MATCH_GIT_BEARER_AUTHORIZATION=...
# MATCH_GIT_PRIVATE_KEY=/secure/match-deploy-key
# MATCH_KEYCHAIN_NAME=ci-signing.keychain-db
# MATCH_KEYCHAIN_PASSWORD=...

# Manual-signing projects do not need MYAPP_MATCH_PASSWORD or MYAPP_ASC_*.
# Their Team ID, certificate label, and Bundle ID -> profile-name mappings live in the CMS.
# The matching identity/private key must already be installed for the macOS runner user.
# CMS profile import installs only .mobileprovision files for the API macOS user, so API
# and worker should run as the same user when using manual signing discovery/import.

# Deprecated during migration from the original single-project setup:
# ALLOWED_USER_IDS=ou_xxxxx,ou_yyyyy
# ALLOWED_PROJECT_IDS=MyApp
# IOS_PROJECT_PATH=/path/to/ios-project
# FASTLANE_SCRIPT_PATH=./scripts/run_fastlane.sh
# START_WORKER_IN_PROCESS=false
