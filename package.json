{
  "name": "autopushapp",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "web"
  ],
  "description": "Multi-project iOS Fastlane build CMS with Lark integration.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:web": "npm run dev --workspace web",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "npm run build --workspace web",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace web",
    "lint": "npm run typecheck",
    "test": "vitest run && npm test --workspace web",
    "test:coverage": "vitest run --coverage && npm run test:coverage --workspace web"
  },
  "keywords": [
    "lark",
    "fastlane",
    "firebase",
    "ios",
    "ci-cd",
    "cms"
  ],
  "author": "",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "@larksuiteoapi/node-sdk": "^1.53.0",
    "better-sqlite3": "^11.10.0",
    "bullmq": "^5.41.5",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "plist": "^3.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.5",
    "@types/plist": "^3.0.5",
    "@vitest/coverage-v8": "^3.0.7",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
